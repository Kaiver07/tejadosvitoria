---
import PageLayout from '../layouts/PageLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ContactForm from '../components/ContactForm.astro';
import { site } from '../config/site.config';

const title = `Contacto | ${site.name}`;
const description = `Contacta con ${site.name}. Llama al ${site.phoneDisplay}, presupuesto gratuito y respuesta en menos de 24 horas.`;
---

<PageLayout title={title} description={description}>

  <div class="bg-gray-50 border-b border-gray-200">
    <div class="section-container py-3">
      <Breadcrumb items={[{ name: 'Contacto', href: '/contacto/' }]} />
    </div>
  </div>

  <section class="bg-brand-primary text-white">
    <div class="section-container py-12">
      <h1 class="text-3xl sm:text-4xl font-bold mb-3">Contacto</h1>
      <p class="text-gray-300 text-lg">Presupuesto gratuito sin compromiso. Respondemos en menos de 24 horas.</p>
    </div>
  </section>

  <section class="section-padding bg-white">
    <div class="section-container">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">

        <!-- Info de contacto -->
        <div>
          <h2 class="text-2xl font-bold text-brand-primary mb-6">Cómo Contactarnos</h2>

          <p class="text-gray-600 mb-6 leading-relaxed">
            Llevamos {site.yearsExperience} años reparando e instalando tejados en Vitoria-Gasteiz y toda la comarca de Álava. Ya sea una urgencia de gotera o un presupuesto sin prisa, respondemos a cualquier consulta —por teléfono, email o formulario— en menos de 24 horas, con desplazamiento incluido dentro de nuestra área de trabajo habitual.
          </p>

          <div class="space-y-5">
            <div class="flex gap-4">
              <div class="w-10 h-10 bg-brand-secondary/10 rounded-lg flex items-center justify-center flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-brand-secondary" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/>
                </svg>
              </div>
              <div>
                <p class="font-semibold text-gray-800">Teléfono</p>
                <a href={`tel:${site.phone}`} class="text-brand-secondary font-bold text-xl hover:underline">
                  {site.phoneDisplay}
                </a>
                <p class="text-gray-500 text-sm mt-0.5">Urgencias 24h · 7 días a la semana</p>
              </div>
            </div>

            <div class="flex gap-4">
              <div class="w-10 h-10 bg-brand-secondary/10 rounded-lg flex items-center justify-center flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-brand-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <p class="font-semibold text-gray-800">Email</p>
                <a href={`mailto:${site.email}`} class="text-brand-secondary hover:underline">
                  {site.email}
                </a>
              </div>
            </div>

            <div class="flex gap-4">
              <div class="w-10 h-10 bg-brand-secondary/10 rounded-lg flex items-center justify-center flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-brand-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <p class="font-semibold text-gray-800">Dirección</p>
                <address class="not-italic text-gray-600 text-sm">
                  {site.address.street}<br />
                  {site.address.postalCode} {site.address.city}<br />
                  {site.address.province}
                </address>
              </div>
            </div>

            <div class="flex gap-4">
              <div class="w-10 h-10 bg-brand-secondary/10 rounded-lg flex items-center justify-center flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-brand-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div>
                <p class="font-semibold text-gray-800">Horario</p>
                <p class="text-gray-600">{site.hours}</p>
              </div>
            </div>

            <div class="flex gap-4">
              <div class="w-10 h-10 bg-brand-secondary/10 rounded-lg flex items-center justify-center flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-brand-secondary" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" />
                </svg>
              </div>
              <div>
                <p class="font-semibold text-gray-800">Facebook</p>
                <a href={site.social.facebook} target="_blank" rel="noopener noreferrer" class="text-brand-secondary hover:underline">
                  Síguenos en Facebook
                </a>
              </div>
            </div>

            <div class="flex gap-4">
              <div class="w-10 h-10 bg-brand-secondary/10 rounded-lg flex items-center justify-center flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-brand-secondary" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zm0 10.162a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z" />
                </svg>
              </div>
              <div>
                <p class="font-semibold text-gray-800">Instagram</p>
                <a href={site.social.instagram} target="_blank" rel="noopener noreferrer" class="text-brand-secondary hover:underline">
                  Síguenos en Instagram
                </a>
              </div>
            </div>
          </div>

          <!-- Mapa embed simple (sin API de Google Maps) -->
          <div class="mt-8 rounded-xl overflow-hidden border border-gray-200 aspect-video">
            <iframe
              title={`Localización de ${site.name} en ${site.address.city}`}
              src={`https://www.openstreetmap.org/export/embed.html?bbox=-2.7&lat=42.8467&zoom=13&layers=M&marker=${site.geo.lat},${site.geo.lng}`}
              width="100%"
              height="100%"
              loading="lazy"
              style="border: 0;"
            ></iframe>
          </div>
        </div>

        <!-- Formulario -->
        <div>
          <ContactForm title="Solicitar Presupuesto" subtitle="Rellena el formulario y te llamamos en menos de 24 horas." />
        </div>

      </div>
    </div>
  </section>

</PageLayout>
