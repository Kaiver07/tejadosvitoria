---
import { Image } from 'astro:assets';
import { site } from '../config/site.config';
import logoIcon from '../images/brand/logo-icon.png';
const year = new Date().getFullYear();
---

<footer class="bg-brand-primary text-white">
  <div class="section-container py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10">

      <!-- NAP -->
      <div>
        <div class="flex items-center gap-2.5 mb-4">
          <div class="w-10 h-10 bg-white rounded-full flex items-center justify-center flex-shrink-0 p-2">
            <Image src={logoIcon} alt="" width={80} height={80} class="w-full h-full object-contain" />
          </div>
          <h3 class="font-bold text-lg">{site.name}</h3>
        </div>
        <address class="not-italic text-gray-300 space-y-2 text-sm">
          <p>{site.address.street}</p>
          <p>{site.address.postalCode} {site.address.city}</p>
          <p>{site.address.province}, {site.address.region}</p>
          <p class="pt-2">
            <a href={`tel:${site.phone}`} class="text-brand-accent hover:text-white font-semibold transition-colors">
              ☎ {site.phoneDisplay}
            </a>
          </p>
          <p>
            <a href={`mailto:${site.email}`} class="hover:text-white transition-colors">
              {site.email}
            </a>
          </p>
          <p class="pt-1">{site.hours}</p>
          <p class="pt-2">
            <a
              href={site.social.facebook}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-brand-accent hover:text-white transition-colors"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4" aria-hidden="true">
                <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" />
              </svg>
              Síguenos en Facebook
            </a>
          </p>
          <p class="pt-1">
            <a
              href={site.social.instagram}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-brand-accent hover:text-white transition-colors"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4" aria-hidden="true">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zm0 10.162a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z" />
              </svg>
              Síguenos en Instagram
            </a>
          </p>
        </address>
      </div>

      <!-- Servicios -->
      <div>
        <h3 class="font-bold text-lg mb-4">Servicios</h3>
        <ul class="space-y-1.5 text-sm text-gray-300">
          {site.services.map((s) => (
            <li>
              <a href={`/servicio/${s.slug}/`} class="hover:text-white transition-colors">
                {s.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Empresa + Legal -->
      <div>
        <h3 class="font-bold text-lg mb-4">Empresa</h3>
        <ul class="space-y-1.5 text-sm text-gray-300">
          <li><a href="/zonas-donde-trabajamos/" class="hover:text-white transition-colors">Zonas de Trabajo</a></li>
          <li><a href="/contacto/" class="hover:text-white transition-colors">Contacto</a></li>
        </ul>
        <h3 class="font-bold text-lg mt-6 mb-4">Legal</h3>
        <ul class="space-y-1.5 text-sm text-gray-300">
          <li><a href="/aviso-legal/" class="hover:text-white transition-colors">Aviso Legal</a></li>
          <li><a href="/politica-de-privacidad/" class="hover:text-white transition-colors">Política de Privacidad</a></li>
          <li><a href="/politica-de-cookies/" class="hover:text-white transition-colors">Política de Cookies</a></li>
        </ul>
      </div>

    </div>

    <div class="border-t border-white/20 mt-10 pt-6 text-sm text-gray-400 flex flex-col sm:flex-row justify-between gap-2">
      <p>© {year} {site.legal.legalName} ({site.legal.tradeName}) · NIF {site.legal.nif}</p>
      <p>{site.address.city} · {site.address.province} · España</p>
    </div>
  </div>
</footer>
